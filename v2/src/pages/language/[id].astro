---
import Layout from '../../layouts/Layout.astro';
import Catalog from '../../components/Catalog';
import { languages, catalog } from '../../lib/content';
export function getStaticPaths() { return languages.map(language => ({ params: { id: language.id }, props: { language } })); }
const { language } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const related = catalog.filter(idiom => idiom.languageIds.includes(language.id));
const types = { static: '静态类型', dynamic: '动态类型', gradual: '渐进类型' };
---
<Layout title={language.name} description={language.description}>
  <a class="back-link" href={`${base}/languages/`}>← 全部语言</a>
  <section class="intro"><p class="eyebrow">LANGUAGE</p><h1>{language.name}</h1><p>{language.description}</p></section>
  <section class="card language-facts" aria-label="语言资料"><dl><div><dt>资料记录版本</dt><dd>{language.version}</dd></div><div><dt>类型系统</dt><dd>{types[language.typeSystem]}</dd></div><div><dt>编程范式</dt><dd>{language.paradigms.join(' · ')}</dd></div></dl><h2>语言特性</h2><div class="badges">{language.features.map(feature => <span class="badge">{feature}</span>)}</div><p><a href={language.officialDocs} target="_blank" rel="noopener noreferrer">官方文档 ↗<span class="sr-only">（新窗口）</span></a></p></section>
  <section aria-labelledby="related-heading"><h2 id="related-heading">已收录的习语</h2><p class="muted">以下仅表示当前资料覆盖，不代表这门语言的全部能力。</p><Catalog summaries={related} languages={languages} base={base} client:load /></section>
</Layout>
