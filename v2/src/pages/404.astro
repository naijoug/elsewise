---
import Page from '../templates/NotFoundPage.astro';
---
<Page />
<script>
// Pages serves this same fallback for unknown routes. Keep an English URL in English.
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
if(window.location.pathname.startsWith(`${base}/en/`)) window.location.replace(`${base}/en/404/`);
</script>
