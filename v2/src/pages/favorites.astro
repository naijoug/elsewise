---
import FeatureCatalog from '../components/FeatureCatalog';
import { featureSummaries } from '../lib/feature-content';
import Layout from '../layouts/Layout.astro';
import Catalog from '../components/Catalog';
import { catalog, languages } from '../lib/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="我的收藏">
  <section class="intro"><p class="eyebrow">YOUR COLLECTION</p><h1>值得再看一遍的想法。</h1><p>收藏保存在当前浏览器，不会同步到其他设备。清除浏览器数据会移除收藏。</p></section>
  <Catalog summaries={catalog} languages={languages} base={base} initialFavoritesOnly={true} client:load />
  <h2>收藏的语言特性</h2><FeatureCatalog features={featureSummaries} languages={languages} base={base} favoritesOnly={true} client:load />
  <noscript><p class="notice">读取本地收藏需要 JavaScript。你仍可<a href={`${base}/`}>浏览全部习语</a>。</p></noscript>
</Layout>
