---
import '../styles.css';
import { brand } from '../../../src/config/brand';
import ThemeToggle from '../components/ThemeToggle';
import {routeBase, type Locale} from '../lib/localized-content';
interface Props { title: string; description?: string; locale?: Locale }
const { title, description, locale='zh' } = Astro.props;
const en=locale==='en'; const base=routeBase(locale);
const root=import.meta.env.BASE_URL.replace(/\/$/,'');
const path=Astro.url.pathname.slice(root.length).replace(/^\/en(?=\/|$)/,'') || '/';
const alternatePath=/^\/404(?:\.html|\/)?$/.test(path)?(en?'/404.html':'/404/'):path;
const alternate=`${root}${en?'':'/en'}${alternatePath}${Astro.url.search}`;
const links = [{href: `${base}/`, title: en?'Knowledge':'知识目录'}, {href: `${base}/languages/`, title: en?'Languages':'语言'}, {href: `${base}/favorites/`, title: en?'Saved':'收藏'}];
---
<!doctype html>
<html lang={en?'en':'zh-CN'} data-theme="light">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || (en?'Learn one task. Compare implementations across programming languages.':'围绕同一个任务，对照不同编程语言的实现与用法。')} />
    <title>{title} · {en?'Elsewise':'异曲'}</title>
    <script is:inline>
      try { const stored = localStorage.getItem('elsewise_preferences') ?? localStorage.getItem('bytebite_preferences'); const preferences = stored ? JSON.parse(stored) : null; document.documentElement.dataset.theme = preferences?.theme === 'dark' ? 'dark' : 'light'; } catch { }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{en?'Skip to content':'跳转到主内容'}</a>
    <header class="site-header">
      <a class="brand" href={`${base}/`}>{en?'Elsewise':'异曲'}</a>
      <nav aria-label={en?'Main navigation':'主导航'}>{links.map(link => <a href={link.href} aria-current={Astro.url.pathname === link.href ? 'page' : undefined}>{link.title}</a>)}</nav>
      <div class="header-tools"><a class="locale-switch" href={alternate} lang={en?'zh-CN':'en'} aria-label={en?'Switch to Chinese':'切换至英文'}>{en?'中文':'English'}</a><ThemeToggle locale={locale} client:load /><a class="repository-link" href={brand.repositoryUrl} target="_blank" rel="noopener noreferrer" aria-label={en?'GitHub (new window)':'GitHub（新窗口）'}>GitHub ↗</a></div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">{en?'One task, many languages. Learning records and favorites stay in this browser.':'同一个任务，不同语言的做法。学习记录与收藏仅保存在当前浏览器。'}<a class="footer-repository" href={brand.repositoryUrl} target="_blank" rel="noopener noreferrer" aria-label={en?'GitHub (new window)':'GitHub（新窗口）'}>GitHub ↗</a></footer>
  </body>
</html>
