---
import Layout from '../layouts/Layout.astro';
import TopicArt from '../components/TopicArt.astro';
import DocsNav from '../components/DocsNav.astro';
import DetailControls from '../components/DetailControls';
import CopyCode from '../components/CopyCode';
import { content, routeBase, type Locale } from '../lib/localized-content';
import { chapters, knowledge } from '../lib/knowledge';
import { highlight } from '../lib/content';
import { getMessages } from '../lib/messages';

interface Props {
  id: string;
  locale?: Locale;
}

const { id, locale = 'zh' } = Astro.props;
const base = routeBase(locale);
const t = getMessages(locale);
const { features, languages } = content(locale);
const doc = features.find((f) => f.id === id)!;
const module = chapters.find(
  (m) => m.id === knowledge(locale).find((i) => i.id === `feature:${id}`)?.chapter
);
---
<Layout title={doc.title} description={doc.description} locale={locale}>
  <div class="docs-workspace">
    <div class="docs-article">
      <header class="document-heading topic-heading">
        <TopicArt topic={id} chapter={module?.id} />
        <div class="topic-path">
          <DocsNav locale={locale} active={id} />
          <a href={`${base}/?chapter=${module?.id || ''}`}>{module?.[locale]}</a>
        </div>
        <h1>{doc.title}</h1>
        <p>{doc.description}</p>
      </header>

      <DetailControls
        idiomId={`feature:${id}`}
        subject={t.article.documentSubject}
        options={doc.entries.map((e) => ({
          id: e.languageId,
          name: languages.find((l) => l.id === e.languageId)!.name,
        }))}
        locale={locale}
        client:load
      />


      <noscript>
        <p>{t.article.noScriptNotice}</p>
      </noscript>

      <div class="code-grid" data-code-grid>
        {doc.entries.map((entry) => {
          const language = languages.find((l) => l.id === entry.languageId)!;
          const codeId = `code-${id}-${language.id}`;
          return (
            <article
              class="implementation"
              data-language-card={language.id}
              aria-labelledby={`heading-${language.id}`}
            >
              <header class="implementation-header">
                <h2 id={`heading-${language.id}`}>
                  <a href={`${base}/language/${language.id}/`}>{language.name}</a>
                </h2>
                {entry.code && (
                  <CopyCode targetId={codeId} locale={locale} client:load />
                )}
              </header>
              {entry.code && (
                <pre
                  tabindex="0"
                  aria-label={`${language.name} ${t.article.exampleCode}`}
                ><code
                    id={codeId}
                    class={`language-${language.id}`}
                    set:html={highlight(entry.code, language.id)}
                  /></pre>
              )}
              <div class="implementation-body">
                <p class="runtime-label">{entry.baseline}</p>
                <p>{entry.summary}</p>
                <p class="muted support-note">
                  {t.article.statusLabels[entry.status]}
                </p>
              </div>
              <div class="implementation-body">
                <h3>{t.article.envBoundaries}</h3>
                <p>{entry.versionNotes}</p>
                <details class="source-details">
                  <summary>
                    {t.article.sourcesAndDocs} ({entry.sources.length})
                  </summary>
                  <ul>
                    {entry.sources.map((source) => (
                      <li>
                        <a
                          href={source.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {source.title}
                          <span class="sr-only">{t.collection.newWindow}</span> ↗
                        </a>
                        <p class="muted">
                          {t.article.reviewedAt} {source.checkedAt}
                        </p>
                      </li>
                    ))}
                  </ul>
                </details>
              </div>
            </article>
          );
        })}
      </div>
      <p class="doc-context">{t.article.unrunDisclaimer}</p>

      <section class="related-docs">
        <h2>{t.article.continueReading}</h2>
        <ul>
          {doc.related
            .map((relatedId) => features.find((f) => f.id === relatedId)!)
            .map((f) => (
              <li>
                <a href={`${base}/feature/${f.id}/`}>{f.title}</a>
              </li>
            ))}
          {doc.idiomIds.map((idiomId) => (
            <li>
              <a href={`${base}/idiom/${idiomId}/`}>
                {idiomId === 'closure'
                  ? t.article.statefulClosure
                  : content(locale).idioms.find((i) => i.id === idiomId)!.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Layout>
