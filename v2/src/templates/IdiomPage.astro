---
import Layout from '../layouts/Layout.astro';
import TopicArt from '../components/TopicArt.astro';
import DocsNav from '../components/DocsNav.astro';
import { knowledge, chapters } from '../lib/knowledge';
import DetailControls from '../components/DetailControls';
import CopyCode from '../components/CopyCode';
import { content, routeBase, type Locale } from '../lib/localized-content';
import { highlight } from '../lib/content';
import { getMessages } from '../lib/messages';

interface Props {
  id: string;
  locale?: Locale;
}

const { id, locale = 'zh' } = Astro.props;
const base = routeBase(locale);
const t = getMessages(locale);
const { idioms, languages, features } = content(locale);
const idiom = idioms.find((i) => i.id === id)!;
const chapter = chapters.find(
  (c) =>
    knowledge(locale).find(
      (i) => i.id === id || (id === 'closure' && i.id === 'feature:closures')
    )?.chapter === c.id
);
const options = idiom.implementations.map((i) => ({
  id: i.languageId,
  name: languages.find((l) => l.id === i.languageId)!.name,
}));
---
<Layout title={idiom.title} description={idiom.description} locale={locale}>
  <div class="docs-workspace">
    <div class="docs-article">
      <header class="document-heading topic-heading">
        <TopicArt topic={id} chapter={chapter?.id} />
        <div class="topic-path">
          <DocsNav locale={locale} active={`idiom:${id}`} />
          <a href={`${base}/?chapter=${chapter?.id || ''}`}>{chapter?.[locale]}</a>
        </div>
        <h1>{idiom.title}</h1>
        <p>{idiom.description}</p>
      </header>

      <DetailControls
        idiomId={id}
        options={options}
        locale={locale}
        client:load
      />


      <noscript>
        <p>{t.article.noScriptNotice}</p>
      </noscript>

      <div class="code-grid" data-code-grid>
        {idiom.implementations.map((implementation) => {
          const language = languages.find((l) => l.id === implementation.languageId)!;
          const codeId = `code-${id}-${language.id}`;
          return (
            <article
              class="implementation"
              data-language-card={language.id}
              aria-labelledby={`heading-${language.id}`}
            >
              <header class="implementation-header">
                <h2 id={`heading-${language.id}`}>
                  <a href={`${base}/language/${language.id}/`}>{language.name}</a>
                </h2>
                <CopyCode targetId={codeId} locale={locale} client:load />
              </header>
              <pre
                tabindex="0"
                aria-label={`${language.name} ${t.article.exampleCode}`}
              ><code
                  id={codeId}
                  class={`language-${language.id}`}
                  set:html={highlight(implementation.code, language.id)}
                /></pre>
              <div class="implementation-body">
                <h3>{t.article.howItWorks}</h3>
                <p>{implementation.explanation}</p>

                {implementation.output !== undefined && (
                  <section>
                    <h3>{t.article.expectedOutput}</h3>
                    <pre tabindex="0"><code>{implementation.output}</code></pre>
                  </section>
                )}

                {implementation.errorOutput !== undefined && (
                  <section>
                    <h3>{t.article.errorOutput}</h3>
                    <pre tabindex="0"><code>{implementation.errorOutput}</code></pre>
                  </section>
                )}

                {implementation.designRationale && (
                  <section>
                    <h3>{t.article.designRationale}</h3>
                    <p>{implementation.designRationale}</p>
                  </section>
                )}

                {implementation.pros?.length ? (
                  <section>
                    <h3>{t.article.advantages}</h3>
                    <ul>
                      {implementation.pros.map((v) => (
                        <li>{v}</li>
                      ))}
                    </ul>
                  </section>
                ) : null}

                {implementation.cons?.length ? (
                  <section>
                    <h3>{t.article.tradeoffs}</h3>
                    <ul>
                      {implementation.cons.map((v) => (
                        <li>{v}</li>
                      ))}
                    </ul>
                  </section>
                ) : null}

                {implementation.references?.length ? (
                  <section>
                    <h3>{t.article.references}</h3>
                    <ul>
                      {implementation.references.map((r) => (
                        <li>
                          <a
                            href={r.url}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {r.title}
                            <span class="sr-only">
                              {t.collection.newWindow}
                            </span>{' '}
                            ↗
                          </a>
                        </li>
                      ))}
                    </ul>
                  </section>
                ) : null}
              </div>
            </article>
          );
        })}
      </div>
      <p class="doc-context">{t.article.idiomDisclaimer}</p>

      {features.some((f) => f.idiomIds.includes(id)) && (
        <section class="related-docs">
          <h2>{t.article.relatedDocs}</h2>
          <ul>
            {features
              .filter((f) => f.idiomIds.includes(id))
              .map((f) => (
                <li>
                  <a href={`${base}/feature/${f.id}/`}>{f.title}</a>
                </li>
              ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</Layout>
