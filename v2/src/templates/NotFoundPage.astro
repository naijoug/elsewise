---
import Layout from '../layouts/Layout.astro';
import { routeBase, type Locale } from '../lib/localized-content';
import { getMessages } from '../lib/messages';

interface Props {
  locale?: Locale;
}

const { locale = 'zh' } = Astro.props;
const base = routeBase(locale);
const t = getMessages(locale);
---
<Layout title={t.notFound.title} locale={locale}>
  <section class="document-heading">
    <p class="eyebrow">404</p>
    <h1>{t.notFound.heading}</h1>
    <p>{t.notFound.message}</p>
    <div class="actions">
      <a class="button-link" href={`${base}/`}>
        {t.notFound.browseKnowledge}
      </a>
    </div>
  </section>
</Layout>
