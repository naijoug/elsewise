---
import Layout from '../layouts/Layout.astro';
import KnowledgeCatalog from '../components/KnowledgeCatalog';
import { knowledge, chapters } from '../lib/knowledge';
import { content, routeBase, type Locale } from '../lib/localized-content';
import { getMessages } from '../lib/messages';

interface Props {
  locale?: Locale;
  kind?: string;
  id?: string;
}

const { locale = 'zh', kind = 'idioms', id } = Astro.props;
const base = routeBase(locale);
const t = getMessages(locale);
const { languages } = content(locale);
const language = languages.find((l) => l.id === id);

let title = t.collection.knowledgeTitle;
let description = t.collection.knowledgeDesc;

if (kind === 'favorites') {
  title = t.collection.favoritesTitle;
  description = t.collection.favoritesDesc;
} else if (kind === 'languages') {
  title = t.collection.languagesTitle;
  description = t.collection.languagesDesc;
} else if (kind === 'language' && language) {
  title = language.name;
  description = language.description;
}
---
<Layout title={title} locale={locale}>
  <header class="document-heading">
    <h1>{title}</h1>
    <p>{description}</p>
  </header>

  {kind === 'languages' && (
    <ul class="language-directory">
      {languages.map((lang) => (
        <li>
          <a href={`${base}/language/${lang.id}/`}>
            <strong>{lang.name}</strong>
            <span>{lang.description}</span>
          </a>
        </li>
      ))}
    </ul>
  )}

  {kind === 'language' && language && (
    <>
      <a href={`${base}/languages/`} class="back-link">
        ← {t.collection.allLanguages}
      </a>
      <p>
        <a href={language.officialDocs} target="_blank" rel="noopener noreferrer">
          {t.collection.docLink} ↗
          <span class="sr-only">{t.collection.newWindow}</span>
        </a>
      </p>
      <details class="language-reference">
        <summary>{t.collection.languageReference}</summary>
        <dl>
          <dt>{t.collection.baselineLabel}</dt>
          <dd>{language.version}</dd>
          <dt>{t.collection.typeSystemLabel}</dt>
          <dd>{t.collection.typeSystems[language.typeSystem]}</dd>
          <dt>{t.collection.paradigmsLabel}</dt>
          <dd>{language.paradigms.join(' · ')}</dd>
        </dl>
        <p>{language.features.join(' · ')}</p>
        <p class="muted">{t.collection.metadataDisclaimer}</p>
      </details>
      <KnowledgeCatalog
        items={knowledge(locale).filter((i) => i.languageIds.includes(id!))}
        chapters={chapters.map((c) => ({ id: c.id, title: c[locale] }))}
        languages={languages.map((l) => ({ id: l.id, name: l.name }))}
        base={base}
        locale={locale}
        client:load
      />
    </>
  )}

  {kind !== 'languages' && kind !== 'language' && (
    <>
      <KnowledgeCatalog
        items={knowledge(locale)}
        chapters={chapters.map((c) => ({ id: c.id, title: c[locale] }))}
        languages={languages.map((l) => ({ id: l.id, name: l.name }))}
        base={base}
        locale={locale}
        savedOnly={kind === 'favorites'}
        client:load
      />
      {kind === 'favorites' && (
        <noscript>
          <p>{t.collection.favoritesNoScript}</p>
        </noscript>
      )}
    </>
  )}
</Layout>
