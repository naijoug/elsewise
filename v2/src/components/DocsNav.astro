---
import { routeBase, type Locale } from '../lib/localized-content';
import { knowledge, chapters } from '../lib/knowledge';
import { getMessages } from '../lib/messages';

interface Props {
  locale: Locale;
  active?: string;
}

const { locale, active } = Astro.props;
const items = knowledge(locale);
const base = routeBase(locale);
const t = getMessages(locale);
const key = active?.startsWith('idiom:') ? active.slice(6) : active ? `feature:${active}` : undefined;
const current = items.find((i) => i.id === key || (key === 'closure' && i.id === 'feature:closures'));
---
<aside class="docs-sidebar">
  <details>
    <summary>{t.sidebar.contents} <span aria-hidden="true">⌄</span></summary>
    <nav aria-label={t.sidebar.contents}>
      <a class="directory-back" href={`${base}/`}>
        ← {t.sidebar.allTopics}
      </a>
      {chapters.map((chapter, n) => (
        <section>
          <h2>
            <a href={`${base}/?chapter=${chapter.id}`}>
              {String(n + 1).padStart(2, '0')} · {chapter[locale]}
            </a>
          </h2>
          {chapter.id === current?.chapter && (
            <ul>
              {items
                .filter((i) => i.chapter === chapter.id)
                .map((item) => (
                  <li>
                    <a href={`${base}${item.href}`} aria-current={item.id === current.id ? 'page' : undefined}>
                      {item.title}
                    </a>
                  </li>
                ))}
            </ul>
          )}
        </section>
      ))}
    </nav>
  </details>
</aside>
